NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/carpinteria_db
# Solo para migraciones/tareas directas; no es necesario en el servidor web.
DATABASE_URL_UNPOOLED=
ADMIN_EMAIL=
ADMIN_RATE_LIMIT_KEY=

# Development and controlled tests may use "local". Production requires "cloudinary".
MEDIA_STORAGE_PROVIDER=local
# Optional local filesystem path; ignored by the Cloudinary provider.
MEDIA_STORAGE_DIR=
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_MAX_BATCH_FILES=100
MEDIA_MAX_VIDEO_FILE_BYTES=52428800

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Recuperación de contraseña: claves independientes, 32 bytes hexadecimales cada una.
EMAIL_ENCRYPTION_KEY=
EMAIL_LOOKUP_KEY=
PASSWORD_RECOVERY_KEY=

# Required before enabling password recovery in production.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
